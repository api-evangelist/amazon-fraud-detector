        {
          "info": {
            "name": "Put Event Type",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://frauddetector.{region}.amazonaws.com/event-types",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates or updates an event type."
        }
      ]
    }
  ],
  "bundled": true
