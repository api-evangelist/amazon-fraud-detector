{
  "opencollection": "1.0.0",
  "info": {
    "name": "Amazon Fraud Detector Detectors Predictions API",
    "version": "2019-11-15"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Predictions",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Event Prediction",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://frauddetector.{region}.amazonaws.com/predictions/event/:eventId",
            "params": [
              {
                "name": "eventId",
                "value": "",
                "type": "path",
                "description": "The unique ID of the event."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Evaluates an event against a detector version and returns prediction outcomes."
        }
      ]
    }
  ],
  "bundled": true
}