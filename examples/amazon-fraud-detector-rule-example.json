{
  "ruleId": "high-risk-block",
  "detectorId": "payment-fraud-detector",
  "ruleVersion": "1",
  "description": "Block transactions with model score > 900",
  "language": "DETECTORPL",
  "expression": "$ofi_model_insightscore > 900",
  "outcomes": [
    "block"
  ],
